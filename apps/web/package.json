{
  "name": "@teknofest-ai/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/assert-build-output-safe.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --experimental-provision=false --experimental-auto-create=false",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local --experimental-provision=false --experimental-auto-create=false",
    "smoke:p2-02:r2": "node ./scripts/p2-02-r2-smoke.mjs",
    "smoke:p2-02": "node ./scripts/p2-02-local-smoke.mjs",
    "smoke:p2-03": "node ./scripts/historical-stage-smoke.mjs p2-03",
    "smoke:p3-01": "node ./scripts/historical-stage-smoke.mjs p3-01",
    "smoke:p3-02": "vitest run src/server/analysis/document-extraction.test.ts src/server/analysis/process-analysis-run.test.ts src/server/analysis/structural-checks.test.ts src/server/analysis/semantic-checks.test.ts src/server/analysis/submission-analysis-workflow.test.ts",
    "smoke:p4-01a": "vitest run src/server/analysis/similarity.test.ts src/server/analysis/similarity-persistence.test.ts src/server/analysis/similarity-candidate-cap.test.ts src/server/analysis/submission-analysis-workflow.test.ts src/server/analysis-routes.test.ts src/client/submissions-page.test.tsx",
    "smoke:p4-01b": "vitest run src/server/analysis/semantic-similarity-provider.test.ts src/server/analysis/semantic-similarity-integration.test.ts src/server/analysis/similarity.test.ts src/server/analysis/similarity-persistence.test.ts src/server/analysis/similarity-candidate-cap.test.ts src/server/analysis/submission-analysis-workflow.test.ts src/server/analysis-routes.test.ts src/client/submissions-page.test.tsx",
    "smoke:p4-01b:remote": "tsx scripts/p4-01b-remote-smoke.ts",
    "smoke:p5": "vitest run src/server/review-routes.test.ts src/server/review-evaluation.test.ts src/server/authorization/authorization.test.ts src/client/review-workspace-page.test.tsx src/client/review/evidence-navigation.test.ts src/client/review/report-object-url.test.ts src/server/analysis/rubric-checks.test.ts",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@teknofest-ai/ai": "workspace:*",
    "@teknofest-ai/db": "workspace:*",
    "@teknofest-ai/shared": "workspace:*",
    "better-auth": "1.7.0",
    "franc-min": "6.2.0",
    "hono": "4.13.3",
    "iso-639-3": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
