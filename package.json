{
  "name": "teknofest-ai-evaluationsystem",
  "version": "0.0.0",
  "private": true,
  "description": "TEKNOFEST raporları için insan kontrollü, yapay zekâ destekli değerlendirme platformu.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @teknofest-ai/web dev",
    "build": "pnpm --filter @teknofest-ai/web build",
    "typecheck": "pnpm --filter @teknofest-ai/shared typecheck && pnpm --filter @teknofest-ai/ai typecheck && pnpm --filter @teknofest-ai/db typecheck && pnpm --filter @teknofest-ai/web typecheck",
    "test": "pnpm --filter @teknofest-ai/shared test && pnpm --filter @teknofest-ai/ai test && pnpm --filter @teknofest-ai/db test && pnpm --filter @teknofest-ai/web test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "auth:schema:generate": "pnpm --filter @teknofest-ai/db auth:schema:generate",
    "db:generate": "pnpm --filter @teknofest-ai/db db:generate",
    "db:migrate:local": "pnpm --filter @teknofest-ai/web db:migrate:local",
    "db:migrations:list:local": "pnpm --filter @teknofest-ai/web db:migrations:list:local",
    "smoke:p2-01": "pnpm --filter @teknofest-ai/db smoke:p2-01",
    "smoke:p2-02:r2": "pnpm --filter @teknofest-ai/web smoke:p2-02:r2",
    "smoke:p2-02": "pnpm --filter @teknofest-ai/web smoke:p2-02",
    "smoke:p2-03": "pnpm --filter @teknofest-ai/web smoke:p2-03",
    "smoke:p3-01": "pnpm --filter @teknofest-ai/web smoke:p3-01",
    "smoke:p3-02": "pnpm --filter @teknofest-ai/web smoke:p3-02",
    "cf:typegen": "pnpm --filter @teknofest-ai/web cf:typegen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9"
  }
}
